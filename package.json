{
  "type": "module",
  "name": "@panticonic/vibestudio",
  "productName": "Vibestudio",
  "version": "0.1.31",
  "private": true,
  "description": "A horizontally stacked panel app built with Electron and TypeScript",
  "main": "dist/main.cjs",
  "bin": {
    "vibestudio": "scripts/vibestudio-launcher.mjs",
    "vibestudio-server": "dist/server.mjs"
  },
  "scripts": {
    "build": "node scripts/generate-system-epoch.mjs && NODE_ENV=production node build.mjs",
    "build:infrastructure": "node scripts/build-infrastructure-packages.mjs",
    "bootstrap": "pnpm install",
    "bootstrap:frozen": "pnpm install --frozen-lockfile",
    "dev": "tsx src/dev/runInstance.ts desktop --ephemeral-workspace",
    "dev:production": "tsx src/dev/runInstance.ts desktop --production-base --ephemeral",
    "dev:base": "tsx scripts/dev-base.ts",
    "dev:iroh": "NODE_ENV=development tsx src/dev/runInstance.ts desktop --dev-iroh-remote --ephemeral",
    "relay:fixture": "node scripts/iroh-relay-fixture.mjs",
    "test:iroh-relay-fixture": "tsx scripts/test-iroh-relay-fixture.ts",
    "cli": "VIBESTUDIO_SERVER_ENTRY=live tsx src/dev/runCli.ts",
    "start": "tsx src/dev/runInstance.ts desktop",
    "headless-host": "VIBESTUDIO_HEADLESS_HOST=1 node scripts/run-electron.mjs --headless-host",
    "server": "node dist/server.mjs --app-root .",
    "server:dev": "NODE_ENV=development node dist/server.mjs --app-root .",
    "server:live": "tsx src/dev/runInstance.ts server",
    "server:production": "tsx src/dev/runInstance.ts server --production-base --ephemeral --instance production-experience",
    "system-test": "tsx src/dev/runSystemTest.ts",
    "template:exchange": "tsx scripts/project-template-repository.ts",
    "pack": "pnpm generate:base-template-release && pnpm build && electron-builder --dir",
    "dist": "pnpm generate:base-template-release && pnpm build && electron-builder",
    "dist:mac": "pnpm generate:base-template-release && pnpm build && electron-builder --mac",
    "dist:win": "pnpm generate:base-template-release && pnpm build && electron-builder --win",
    "dist:linux": "pnpm generate:base-template-release && pnpm build && electron-builder --linux",
    "stage:npm": "pnpm generate:base-template-release && pnpm build && node scripts/build-npm-packages.mjs",
    "setup:npm-token": "node scripts/setup-npm-token.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:npm:staged": "node scripts/publish-npm.mjs --skip-build --skip-stage",
    "generate:brand-assets": "node scripts/generate-brand-assets.mjs",
    "generate:agent-docs": "node scripts/generate-agent-cli-docs.mjs",
    "check:agent-docs": "node scripts/generate-agent-cli-docs.mjs --check",
    "generate:runtime-docs": "node scripts/generate-runtime-docs.mjs",
    "generate:system-epoch": "node scripts/generate-system-epoch.mjs",
    "check:system-epoch": "node scripts/generate-system-epoch.mjs --check",
    "snapshot:historical-host": "node scripts/historical-host-snapshot.mjs",
    "check:runtime-docs": "node scripts/generate-runtime-docs.mjs --check",
    "generate:host-authority": "node scripts/generate-host-authority-catalog.mjs",
    "generate:unit-authority": "node scripts/generate-host-authority-catalog.mjs && node scripts/check-explicit-authority-manifests.mjs && node --import tsx scripts/generate-runtime-foundation-ledgers.mjs",
    "authority:audit-evidence": "node --import tsx scripts/generate-unit-authority-manifests.mjs --check",
    "authority:apply-suggestions": "node --import tsx scripts/generate-unit-authority-manifests.mjs --apply",
    "generate:runtime-foundations": "node --import tsx scripts/generate-runtime-foundation-ledgers.mjs",
    "generate:builtin-catalog": "tsx scripts/generate-builtin-catalog.ts",
    "scaffold:builtin-service": "node scripts/scaffold-builtin-service.mjs",
    "check:builtin-catalog": "tsx scripts/generate-builtin-catalog.ts --check",
    "check:unit-authority": "pnpm build:infrastructure && node scripts/generate-host-authority-catalog.mjs --check && pnpm run check:builtin-catalog && node scripts/check-host-residency-baselines.mjs && node --import tsx scripts/generate-runtime-foundation-ledgers.mjs --check",
    "check:pair-authority": "node scripts/check-explicit-authority-manifests.mjs && node --import tsx scripts/check-capability-notability.mjs && pnpm check:userland-rpc-contracts && node scripts/check-userland-package-manager-boundary.mjs && pnpm check:product-seed-records && pnpm check:vcs-skill-release",
    "generate:product-seed-records": "node --import tsx scripts/generate-product-seed-records.mjs",
    "check:product-seed-records": "node --import tsx scripts/generate-product-seed-records.mjs --check",
    "generate:base-template-release": "node --import tsx scripts/generate-base-template-release.mjs",
    "check:base-template-release": "node --import tsx scripts/generate-base-template-release.mjs --check",
    "check:ledger-evidence": "node scripts/check-runtime-foundation-evidence.mjs",
    "check:execution-root-providers": "node scripts/check-execution-root-provider-census.mjs",
    "generate:vcs-skill-release": "node --import tsx scripts/generate-vcs-skill-release.mjs",
    "check:vcs-skill-release": "node --import tsx scripts/generate-vcs-skill-release.mjs --check",
    "check:build-artifacts": "node scripts/check-build-artifacts.mjs",
    "check:native-host-dependencies": "node scripts/native-host-dependencies.mjs",
    "check:host-boundary": "node scripts/check-host-workspace-imports.mjs",
    "check:package-dependencies": "node scripts/check-package-dependencies.mjs",
    "check:userland-package-manager-boundary": "node scripts/check-userland-package-manager-boundary.mjs",
    "check:userland-dependencies": "node --import tsx scripts/check-userland-dependencies.mjs",
    "check:userland-rpc-contracts": "tsx scripts/check-userland-rpc-contracts.ts",
    "test:host-build-without-workspace": "node scripts/test-host-build-without-workspace.mjs",
    "check:no-single-user": "node scripts/check-no-single-user.mjs",
    "check:iroh-cutover": "node scripts/check-iroh-cutover.mjs",
    "type-check:cloudflare": "pnpm --filter './apps/**' --if-present typecheck:cloudflare",
    "deploy:cloudflare:apex": "pnpm --dir apps/webhook-relay run deploy",
    "deploy:cloudflare": "pnpm deploy:cloudflare:apex",
    "smoke:cloudflare:apex": "node scripts/smoke-cloudflare-apex.mjs",
    "smoke:cloudflare": "pnpm smoke:cloudflare:apex",
    "dev:debug": "VIBESTUDIO_DEBUG_PATHS=1 pnpm dev",
    "dev:verbose": "VIBESTUDIO_LOG_LEVEL=verbose pnpm dev",
    "terminal:jig": "node scripts/run-terminal-input-jig.mjs",
    "terminal:jig:smoke": "node scripts/terminal-input-jig-electron-smoke.mjs",
    "lint": "oxlint src --quiet",
    "lint:advisory": "oxlint src",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,html,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,html,json}'",
    "quality:check": "pnpm check:package-dependencies && pnpm check:iroh-cutover && pnpm type-check && pnpm lint && pnpm format:check && pnpm check:host-boundary && pnpm check:no-single-user && pnpm check:unit-authority && pnpm check:base-template-release && pnpm check:execution-root-providers && pnpm test:host-build-without-workspace",
    "type-check": "pnpm type-check:host",
    "type-check:host": "node_modules/typescript/bin/tsc --noEmit && pnpm type-check:workerd-programs",
    "type-check:workerd-programs": "node_modules/typescript/bin/tsc -p src/server/workerdPrograms/tsconfig.json",
    "type-check:userland": "tsx scripts/type-check-userland.ts",
    "type-check:mobile": "pnpm type-check:userland",
    "type-check:watch": "node_modules/typescript/bin/tsc --noEmit --watch --preserveWatchOutput",
    "test": "pnpm run check:package-dependencies && pnpm run check:agent-docs && pnpm run check:unit-authority && pnpm run check:base-template-release && pnpm run check:execution-root-providers && node scripts/check-runtime-foundation-evidence.mjs --start host && pnpm run test:host && pnpm run check:ledger-evidence",
    "test:pair": "pnpm check:runtime-docs && pnpm check:pair-authority && pnpm type-check:userland && pnpm test:userland",
    "check:commit": "pnpm check:system-epoch && pnpm check:runtime-docs && pnpm check:agent-docs && pnpm check:unit-authority && pnpm check:product-seed-records && pnpm check:execution-root-providers && pnpm check:host-boundary && pnpm check:userland-package-manager-boundary && pnpm check:userland-dependencies && pnpm type-check && pnpm lint && pnpm format:check",
    "test:host": "pnpm build && vitest run --config vitest.host.config.ts",
    "test:userland": "pnpm build && vitest run --config vitest.userland.config.ts",
    "test:mobile": "pnpm --dir apps/mobile test --runInBand",
    "test:extension-smoke": "NODE_ENV=development node scripts/ensure-host-build.mjs && VIBESTUDIO_RUN_SERVER_INTEGRATION=1 vitest run tests/extension-image-service.integration.test.ts",
    "test:headless-panel-integration": "NODE_ENV=development node scripts/ensure-host-build.mjs && VIBESTUDIO_RUN_HEADLESS_PANEL_INTEGRATION=1 vitest run tests/headless-panel.integration.test.ts",
    "test:iroh": "vitest run packages/iroh-transport/src packages/mobile-iroh/src packages/rpc/src/protocol/irohSession.test.ts packages/rpc/src/transports/irohClient.test.ts packages/rpc/src/transports/reconnectingIrohClient.test.ts src/server/irohIngress.test.ts src/server/rpcServer.iroh.test.ts",
    "test:iroh-e2e": "pnpm build:infrastructure && VIBESTUDIO_RUN_IROH_E2E=1 vitest run tests/iroh-remote.e2e.test.ts tests/iroh-electron-native.e2e.test.ts",
    "test:iroh-desktop-e2e": "NODE_ENV=development node scripts/ensure-host-build.mjs && xvfb-run -a node scripts/desktop-pairing-smoke.mjs",
    "test:iroh-mobile-e2e": "NODE_ENV=development node scripts/ensure-host-build.mjs && node scripts/cli/mobile-smoke.mjs --platform android",
    "test:remote-transport": "pnpm test:iroh && pnpm test:iroh-e2e && vitest run tests/remote-doctor.test.ts tests/remote-deploy.test.ts tests/remote-rotate-endpoint.test.ts tests/pair-server.behavior.test.ts",
    "test:terminal-app-smoke": "NODE_ENV=development node scripts/ensure-host-build.mjs && node --import tsx scripts/terminal-app-smoke.mjs",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "NODE_ENV=development node scripts/ensure-host-build.mjs && playwright test -c tests/config/playwright.config.ts",
    "test:e2e:headed": "NODE_ENV=development VIBESTUDIO_E2E_USE_HOST_DISPLAY=1 node scripts/ensure-host-build.mjs && playwright test -c tests/config/playwright.config.ts --headed",
    "test:all": "pnpm test && pnpm test:e2e",
    "prepare": "husky"
  },
  "keywords": [
    "electron",
    "typescript",
    "panel"
  ],
  "author": "Gabriel Pickard",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "allowedBuilds": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "//overrides": "react-native 0.79 peerDeps react ^19.0.0. Pinning here prevents a hoisted React 18 from shadowing RN's requirement in the native mobile host. protobufjs ^7.5.5 patches RCE GHSA-xq3m-2v4x-88gg in host dependency closures. ws pins each host-required major to its patched fragmentation-memory floor. Revisit when bumping RN.",
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "protobufjs": "^7.5.5",
      "ws@6": "6.2.4",
      "ws@7": "7.5.11",
      "ws@8": "8.21.1"
    },
    "patchedDependencies": {
      "react-native-tcp-socket@6.4.1": "patches/react-native-tcp-socket.patch"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@vitest/browser": "3.2.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "ignore": "7.0.5",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "vitest": "^3.2.2"
  },
  "dependencies": {
    "@panticonic/builtin": "workspace:*",
    "@number0/iroh": "1.1.0",
    "@vibestudio/automation": "workspace:*",
    "@vibestudio/iroh-transport": "workspace:*",
    "@babel/core": "^7.29.0",
    "@babel/parser": "^7.29.2",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ghostery/adblocker": "^2.13.4",
    "@cfworker/json-schema": "^4.1.1",
    "@earendil-works/pi-ai": "^0.82.0",
    "@mdx-js/mdx": "^3.1.1",
    "@puppeteer/browsers": "^2.6.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "@tanstack/react-virtual": "^3.13.0",
    "@vscode/ripgrep": "1.18.0",
    "@vibestudio/browser-data": "workspace:*",
    "@vibestudio/browser-contracts": "workspace:*",
    "@vibestudio/browser-import": "workspace:*",
    "@vibestudio/browser-import-archive": "workspace:*",
    "@vibestudio/content-addressing": "workspace:*",
    "@vibestudio/credential-client": "workspace:*",
    "@vibestudio/dev-log": "workspace:*",
    "@vibestudio/durable": "workspace:*",
    "@vibestudio/env-paths": "workspace:*",
    "@vibestudio/extension": "workspace:*",
    "@vibestudio/extension-host": "workspace:*",
    "@vibestudio/git": "workspace:*",
    "@vibestudio/identity": "workspace:*",
    "@vibestudio/mobile-iroh": "workspace:*",
    "@vibestudio/module-imports": "workspace:*",
    "@vibestudio/origin-identity": "workspace:*",
    "@vibestudio/process-adapter": "workspace:*",
    "@vibestudio/rpc": "workspace:*",
    "@vibestudio/service-schemas": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@vibestudio/shell-core": "workspace:*",
    "@vibestudio/sqlite": "workspace:*",
    "@vibestudio/trajectory-identity": "workspace:*",
    "@vibestudio/typecheck": "workspace:*",
    "@vibestudio/types": "workspace:*",
    "@vibestudio/unit-authority-inference": "workspace:*",
    "@vibestudio/unit-host": "workspace:*",
    "@vibestudio/vcs-path-policy": "workspace:*",
    "@vibestudio/workspace": "workspace:*",
    "@vibestudio/workspace-contracts": "workspace:*",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-progress": "^0.2.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.17.1",
    "acorn": "^8.18.0",
    "buffer": "^6.0.3",
    "cross-fetch": "^4.1.0",
    "croner": "^10.0.1",
    "diff": "^7.0.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.27.0",
    "esbuild-svelte": "^0.9.4",
    "firebase-admin": "^12.7.0",
    "isomorphic-git": "^1.36.3",
    "jotai": "^2.17.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.31.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^11.16.1",
    "micromark-extension-gfm": "^3.0.0",
    "shiki": "^3.23.0",
    "sucrase": "^3.35.1",
    "typebox": "^1.1.38",
    "node-pty": "^1.1.0",
    "npm": "^11.13.0",
    "pathe": "^2.0.3",
    "qrcode-terminal": "^0.12.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.4",
    "ses": "^2.2.0",
    "sql.js": "^1.14.1",
    "svelte": "^5.56.9",
    "tldts": "^7.0.19",
    "typescript": "7.0.2",
    "workerd": "^1.20260724.1",
    "ws": "^8.21.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  }
}
