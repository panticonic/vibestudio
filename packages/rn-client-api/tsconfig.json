{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "react-native"],
    "paths": {
      "@vibestudio/rpc": ["../rpc/src/index.ts"],
      "@vibestudio/rpc/*": ["../rpc/src/*"],
      "@vibestudio/shared/*": ["../shared/src/*"],
      "@vibestudio/workspace-contracts/*": ["../workspace-contracts/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
