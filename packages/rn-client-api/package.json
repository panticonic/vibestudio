{
  "name": "@vibestudio/rn-client-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The JavaScript API a React Native client sees under host ABI rn-host-6. Host-provided: the mobile host runtime serves it; clients may import nothing else of the host.",
  "vibestudio": {
    "buildProfile": "source-only"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts",
    "./notificationsProtocol": "./src/notificationsProtocol.ts",
    "./native": "./src/native.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "cd ../.. && vitest run packages/rn-client-api/src",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@vibestudio/rpc": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@vibestudio/workspace-contracts": "workspace:*"
  },
  "peerDependencies": {
    "react-native": "^0.79.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "7.0.2"
  }
}
