{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["node", "react", "react-native"],
    "paths": {
      "@vibestudio/iroh-transport": ["../iroh-transport/src/index.ts"],
      "@vibestudio/rpc": ["../rpc/src/index.ts"],
      "@vibestudio/rpc/*": ["../rpc/src/*"],
      "@vibestudio/service-schemas/*": ["../service-schemas/src/*"],
      "@vibestudio/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
