diff --git a/iroh-js/test/dial-cancellation.mjs b/iroh-js/test/dial-cancellation.mjs
new file mode 100644
index 0000000..8fc3496
--- /dev/null
+++ b/iroh-js/test/dial-cancellation.mjs
@@ -0,0 +1,94 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import net from 'node:net';
+import { Endpoint, SecretKey, RelayMode, EndpointAddr, EndpointId } from '../index.js';
+
+const ALPN = Array.from(Buffer.from('iroh-ffi/dial-cancellation'));
+async function bind(relays = []) {
+  const builder = Endpoint.builder();
+  builder.applyMinimal();
+  builder.secretKey(SecretKey.generate().toBytes());
+  builder.alpns([ALPN]);
+  builder.relayMode(relays.length ? RelayMode.customFromUrls(relays) : RelayMode.disabled());
+  return builder.bind();
+}
+
+async function fixture() {
+  const sockets = new Set();
+  const relay = net.createServer(socket => {
+    sockets.add(socket);
+    socket.on('error', () => {});
+    socket.on('close', () => sockets.delete(socket));
+  });
+  await new Promise(resolve => relay.listen(0, '127.0.0.1', resolve));
+  const relayUrl = `https://127.0.0.1:${relay.address().port}/`;
+  const client = await bind([relayUrl]);
+  const peer = await bind();
+  const incoming = peer.acceptNext();
+  const outgoing = client.connect(peer.addr(), ALPN);
+  const accepting = await (await incoming).accept();
+  const [server, healthy] = await Promise.all([accepting.connect(), outgoing]);
+  const unknown = new EndpointAddr(EndpointId.fromString('0123456789abcdef'.repeat(4)), relayUrl, []);
+  return { client, peer, healthy, server, unknown,
+    async close() {
+      await Promise.all([client.close(), peer.close()]);
+      for (const socket of sockets) socket.destroy();
+      await new Promise(resolve => relay.close(resolve));
+    }
+  };
+}
+
+test('cancel joins stalled dials and preserves a sibling QUIC connection', { timeout: 10000 }, async () => {
+  const f = await fixture();
+  try {
+    for (let i = 0; i < 4; i++) {
+      const attempt = f.client.beginConnect(f.unknown, ALPN);
+      const result = attempt.connect();
+      const rejected = assert.rejects(result, /Dial cancelled/);
+      await attempt.cancel();
+      await rejected;
+      await attempt.cancel();
+    }
+    const outgoing = f.healthy.openBi();
+    const incoming = f.server.acceptBi();
+    const stream = await outgoing;
+    await stream.send.writeAll([42]);
+    await stream.send.finish();
+    const other = await incoming;
+    assert.deepEqual(await other.recv.readExact(1), [42]);
+  } finally { await f.close(); }
+});
+
+test('cancellation before connect is terminal and joinable', { timeout: 10000 }, async () => {
+  const f = await fixture();
+  try {
+    const attempt = f.client.beginConnect(f.unknown, ALPN);
+    await attempt.cancel();
+    await assert.rejects(attempt.connect(), /Dial cancelled/);
+    await assert.rejects(attempt.connect(), /already consumed/);
+    assert.equal(f.client.isClosed(), false);
+  } finally { await f.close(); }
+});
+
+test('endpoint closure settles an owned stalled dial', { timeout: 10000 }, async () => {
+  const f = await fixture();
+  try {
+    const attempt = f.client.beginConnect(f.unknown, ALPN);
+    const result = attempt.connect();
+    let settled = false;
+    const outcome = result.then(
+      connection => ({ connection }),
+      error => ({ error }),
+    ).finally(() => { settled = true; });
+    await new Promise(setImmediate);
+    assert.equal(settled, false, 'the dial must be pending before its endpoint closes');
+    await f.client.close();
+    // Shutdown can settle via closed() or connect's original endpoint-stopping
+    // failure. Preserve that error rather than requiring a translated string.
+    const terminal = await outcome;
+    assert.ok(terminal.error instanceof Error, 'endpoint closure must reject the pending dial');
+    assert.equal(f.client.isClosed(), true);
+    await attempt.cancel();
+    await assert.rejects(attempt.connect(), /already consumed/);
+  } finally { await f.close(); }
+});
