--- /dev/null
+++ b/iroh-js/test/stream-open-cancellation.mjs
@@ -0,0 +1,101 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Endpoint, SecretKey, RelayMode } from '../index.js';
+
+const ALPN = Array.from(Buffer.from('iroh-ffi/stream-open-cancellation'));
+async function bind() {
+  const builder = Endpoint.builder();
+  builder.applyMinimal();
+  builder.secretKey(SecretKey.generate().toBytes());
+  builder.alpns([ALPN]);
+  builder.relayMode(RelayMode.disabled());
+  return builder.bind();
+}
+async function fixture() {
+  const client = await bind();
+  const peer = await bind();
+  try {
+    const accepting = peer.acceptNext();
+    const outgoing = client.connect(peer.addr(), ALPN);
+    const incoming = await (await accepting).accept();
+    const [server, local] = await Promise.all([incoming.connect(), outgoing]);
+    return { client, peer, server, local,
+      async close() { await Promise.all([client.close(), peer.close()]); }
+    };
+  } catch (error) {
+    await Promise.all([client.close(), peer.close()]);
+    throw error;
+  }
+}
+async function exhaustCredit(f) {
+  // The locked noq 1.0.1 transport default advertises 100 bidirectional streams.
+  // Retain all of them: no FIN/reset or peer acceptance can replenish credit.
+  const held = [];
+  for (let i = 0; i < 100; i++) held.push(await f.local.openBi());
+  return held;
+}
+async function transfer(stream, remote, byte) {
+  await stream.send.writeAll([byte]);
+  await stream.send.finish();
+  const incoming = await remote;
+  assert.deepEqual(await incoming.recv.readExact(1), [byte]);
+}
+
+test('cancel joins a credit-blocked stream opening and preserves sibling streams', { timeout: 10000 }, async () => {
+  const f = await fixture();
+  try {
+    const held = await exhaustCredit(f);
+    for (let i = 0; i < 4; i++) {
+      const attempt = f.local.beginOpenBi();
+      let settled = false;
+      const outcome = attempt.open().then(
+        stream => ({ stream }), error => ({ error }),
+      ).finally(() => { settled = true; });
+      await new Promise(setImmediate);
+      assert.equal(settled, false, 'opening must be waiting for peer credit');
+      await attempt.cancel();
+      assert.match((await outcome).error.message, /Stream opening cancelled/);
+      await attempt.cancel();
+      await assert.rejects(attempt.open(), /already consumed/);
+    }
+    await transfer(held[0], f.server.acceptBi(), 42);
+    await transfer(await f.server.openBi(), f.local.acceptBi(), 43);
+    assert.equal(f.local.closeReason(), null);
+  } finally { await f.close(); }
+});
+
+test('stream opening cancelled before consumption is terminal', { timeout: 10000 }, async () => {
+  const f = await fixture();
+  try {
+    const attempt = f.local.beginOpenBi();
+    await attempt.cancel();
+    await assert.rejects(attempt.open(), /Stream opening cancelled/);
+    await assert.rejects(attempt.open(), /already consumed/);
+    await transfer(await f.local.openBi(), f.server.acceptBi(), 44);
+  } finally { await f.close(); }
+});
+
+test('connection closure settles a credit-blocked opening', { timeout: 10000 }, async () => {
+  const f = await fixture();
+  try {
+    const held = await exhaustCredit(f);
+    assert.equal(held.length, 100);
+    const attempt = f.local.beginOpenBi();
+    const rejected = assert.rejects(attempt.open());
+    await new Promise(setImmediate);
+    f.local.close(0n, []);
+    await rejected;
+    await attempt.cancel();
+  } finally { await f.close(); }
+});
+
+test('a returned stream belongs to its caller after its opening is cancelled', { timeout: 10000 }, async () => {
+  const f = await fixture();
+  try {
+    const attempt = f.local.beginOpenBi();
+    const stream = await attempt.open();
+    await assert.rejects(attempt.open(), /already consumed/);
+    await attempt.cancel();
+    await transfer(stream, f.server.acceptBi(), 45);
+  } finally { await f.close(); }
+});
