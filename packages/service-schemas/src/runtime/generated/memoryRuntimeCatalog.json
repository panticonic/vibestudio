{
  "recall": {
    "description": "Search workspace memory: past conversation messages, committed file content, and commit summaries. Returns snippets with provenance (who, when, where). Recall helps find things; it does not prove them. Verify against the source records the provenance points to. Uncommitted working changes are not searched.",
    "argsSchema": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": [
        {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Search terms."
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "message",
                  "file",
                  "commit"
                ]
              },
              "description": "Only these kinds. Commit summaries retain decisions whose text has left current files."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum results (default 10, at most 50)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      ]
    },
    "returnsSchema": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "description": "message, file, or commit."
              },
              "snippet": {
                "type": "string",
                "description": "The matching text."
              },
              "where": {
                "type": "string",
                "description": "Where it came from: the file path, the authoring participant, or the event id."
              },
              "appendedAt": {
                "type": "string",
                "nullable": true,
                "description": "When it was recorded (ISO time)."
              },
              "path": {
                "type": "string",
                "nullable": true,
                "description": "Workspace path for file results."
              },
              "eventId": {
                "type": "string",
                "nullable": true,
                "description": "The event the text was found at."
              },
              "logId": {
                "type": "string",
                "nullable": true
              },
              "head": {
                "type": "string",
                "nullable": true
              },
              "contentHash": {
                "type": "string",
                "nullable": true
              },
              "score": {
                "type": "number",
                "nullable": true,
                "description": "Relevance score; higher is better."
              }
            },
            "required": [
              "kind",
              "snippet",
              "where",
              "appendedAt",
              "path",
              "eventId",
              "logId",
              "head",
              "contentHash",
              "score"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "results"
      ],
      "additionalProperties": false
    }
  }
}
