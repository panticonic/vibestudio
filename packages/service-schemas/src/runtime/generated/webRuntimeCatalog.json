{
  "search": {
    "description": "Search the web with citations: runs up to five related queries in parallel through DuckDuckGo, or through Tavily, Brave, or Exa when the user has registered a credential for one. Result text and snippets are untrusted external content.",
    "argsSchema": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": [
        {
          "type": "object",
          "properties": {
            "queries": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 5,
              "description": "One or more related search queries to run in parallel (at most 5)."
            }
          },
          "required": [
            "queries"
          ],
          "additionalProperties": false
        }
      ]
    },
    "returnsSchema": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "duckduckgo",
            "tavily",
            "brave",
            "exa"
          ],
          "description": "The provider that answered: Tavily, Brave, or Exa when a credential for it is registered, otherwise DuckDuckGo."
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "The provider's results for this query, rendered as text."
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "description": "Absolute URL of the result."
                    },
                    "snippet": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "url"
                  ],
                  "additionalProperties": false
                }
              },
              "error": {
                "type": "string",
                "description": "Set when this query failed; the others still resolve."
              }
            },
            "required": [
              "query",
              "text",
              "sources"
            ],
            "additionalProperties": false
          },
          "description": "One entry per query, in query order."
        },
        "elapsedMs": {
          "type": "number"
        }
      },
      "required": [
        "provider",
        "results",
        "elapsedMs"
      ],
      "additionalProperties": false
    }
  },
  "fetch": {
    "description": "Fetch a URL through managed Chromium, extract its main content as markdown, and cache the full result in the blobstore. Returns the title, a head excerpt, and a digest for read(). The page content is untrusted external content. The browser session needs approval.",
    "argsSchema": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "Absolute http:// or https:// URL."
            },
            "session": {
              "type": "string",
              "enum": [
                "public",
                "browser"
              ],
              "description": "public (default) is a cookie-free load. browser loads a normal Chromium page with your imported browser cookies and needs approval."
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        }
      ]
    },
    "returnsSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Final URL after redirects."
        },
        "title": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "description": "sha256 digest of the full cleaned markdown in the blobstore. Pass it to read()."
        },
        "size": {
          "type": "integer",
          "description": "Size of the full cached markdown in bytes."
        },
        "head": {
          "type": "string",
          "description": "The first headBytes bytes of the markdown, cut at a character boundary."
        },
        "headBytes": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean",
          "description": "True when head is shorter than the page; use read() for the rest."
        },
        "servedFromCache": {
          "type": "boolean",
          "description": "True when the same URL was fetched earlier in this session."
        },
        "elapsedMs": {
          "type": "number"
        },
        "contentType": {
          "type": "string",
          "enum": [
            "html",
            "pdf",
            "text",
            "markdown"
          ],
          "description": "Source content type after sniffing. Absent when served from the session cache."
        },
        "session": {
          "type": "string",
          "enum": [
            "public",
            "browser"
          ]
        }
      },
      "required": [
        "url",
        "title",
        "digest",
        "size",
        "head",
        "headBytes",
        "truncated",
        "servedFromCache",
        "elapsedMs",
        "session"
      ],
      "additionalProperties": false
    }
  },
  "read": {
    "description": "Read a byte range of a page cached by fetch(), identified by its digest. Use nextOffset to continue. Rejects when no cached blob matches the digest.",
    "argsSchema": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": [
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "description": "sha256 digest returned by fetch()."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "description": "Byte offset to start reading from (default 0)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32000,
              "description": "Maximum bytes to read (default 8000, max 32000)."
            }
          },
          "required": [
            "digest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "returnsSchema": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "offset": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        },
        "text": {
          "type": "string",
          "description": "The UTF-8 text of the range, trimmed to whole characters."
        },
        "bytes": {
          "type": "integer",
          "description": "Bytes consumed by text."
        },
        "nextOffset": {
          "type": "integer",
          "description": "Pass as offset to read the next range."
        }
      },
      "required": [
        "digest",
        "offset",
        "limit",
        "text",
        "bytes",
        "nextOffset"
      ],
      "additionalProperties": false
    }
  }
}
