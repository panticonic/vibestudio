# Chromium sandboxes its renderers in an unprivileged user namespace, and
# Ubuntu 24.04+ sets kernel.apparmor_restrict_unprivileged_userns=1, denying
# them to any binary shipping no AppArmor profile. Without this the desktop
# exits before its first window with SIGTRAP.
#
# It also covers every development client the desktop launches: a client runs
# from a private temporary directory, but it reuses this exact executable —
# the executor refuses to launch a binary whose digest differs from its own —
# and a profile attaches to the executable, not to the directory it runs in.
#
# This grants that one permission and nothing else: `flags=(unconfined)` keeps
# the desktop's confinement exactly as it is today rather than trading a
# working sandbox for a weaker system-wide policy.
abi <abi/4.0>,

include <tunables/global>

profile vibestudio "/opt/Vibestudio/vibestudio" flags=(unconfined) {
  userns,

  include if exists <local/vibestudio>
}
