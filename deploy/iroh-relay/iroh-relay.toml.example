enable_relay = true
http_bind_addr = "[::]:80"
enable_quic_addr_discovery = true
enable_metrics = true
metrics_bind_addr = "127.0.0.1:9090"
key_cache_capacity = 65536

[tls]
https_bind_addr = "[::]:443"
quic_bind_addr = "[::]:7842"
hostname = ["relay-REGION.example.com"]
cert_mode = "LetsEncrypt"
cert_dir = "/var/lib/iroh-relay/certs"
prod_tls = true
contact = "mailto:operations@example.com"

[limits]
accept_conn_limit = 100.0
accept_conn_burst = 250

[limits.client.rx]
bytes_per_second = 10485760
max_burst_bytes = 20971520

# Production must replace this beta-safe default with the HTTP endpoint-ID
# registry once its bootstrap/revocation gate has passed.
access = "everyone"
