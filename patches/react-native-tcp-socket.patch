+RCT_EXPORT_METHOD(writeStoredAsset
+                  : (nonnull NSNumber *)cId handle
+                  : (nonnull NSString *)handle callback
+                  : (nonnull NSNumber *)msgId) {
+    TcpSocketClient *client = [self findClient:cId];
+    if (!client)
+        return;
+
+    NSError *error = nil;
+    NSString *path = [self pathForStoredAssetHandle:handle error:&error];
+    if (!path || ![client writeFileAtPath:path msgId:msgId error:&error]) {
+        [self sendEventWithName:@"written"
+                           body:@{
+                               @"id" : cId,
+                               @"msgId" : msgId,
+                               @"err" : error.localizedDescription ?: @"stored asset write failed",
+                           }];
+        if (error) [self onError:client withError:error];
+    }
+}
+
+- (NSString *)pathForStoredAssetHandle:(NSString *)handle error:(NSError **)error {
+    static NSString *const prefix = @"vibestudio-asset-v1:";
+    NSString *digest = [handle hasPrefix:prefix] ? [handle substringFromIndex:prefix.length] : nil;
+    NSRegularExpression *regex = [NSRegularExpression regularExpressionWithPattern:@"^[a-f0-9]{64}$" options:0 error:nil];
+    if (!digest || [regex numberOfMatchesInString:digest options:0 range:NSMakeRange(0, digest.length)] != 1) {
+        if (error) *error = [NSError errorWithDomain:RCTTCPErrorDomain code:RCTTCPBadParamError userInfo:@{NSLocalizedDescriptionKey: @"Invalid stored asset handle"}];
+        return nil;
+    }
+    NSURL *support = [[NSFileManager.defaultManager URLsForDirectory:NSApplicationSupportDirectory inDomains:NSUserDomainMask] firstObject];
+    NSString *root = [[[[support URLByAppendingPathComponent:@"vibestudio-panel-assets" isDirectory:YES]
+                        URLByAppendingPathComponent:@"blobs" isDirectory:YES] path] stringByResolvingSymlinksInPath];
+    NSString *path = [[[NSURL fileURLWithPath:root isDirectory:YES] URLByAppendingPathComponent:digest isDirectory:NO].path stringByResolvingSymlinksInPath];
+    BOOL isDirectory = NO;
+    BOOL valid = [path hasPrefix:[root stringByAppendingString:@"/"]] &&
+                 [NSFileManager.defaultManager fileExistsAtPath:path isDirectory:&isDirectory] && !isDirectory;
+    if (!valid) {
+        if (error) *error = [NSError errorWithDomain:RCTTCPErrorDomain code:RCTTCPBadParamError userInfo:@{NSLocalizedDescriptionKey: @"Stored asset handle is unavailable"}];
+        return nil;
+    }
+    return path;
+}
