      "reason": "Launch adapter reading app-generation state; AppHost remains the durable artifact owner."
    },
    { "source": "src/main/appOrchestrator.ts", "reason": "Desktop observer of host-owned state." },
    {
      "source": "src/main/index.ts",
      "reason": "Desktop bootstrap and observer, not an artifact owner."
    }
  ]
}
