{
  "//": "React Native integration tests use a separate program because React Native ambient globals conflict with Node globals.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["jest"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true
  },
  "include": [
    "../tests/workspace-integration/mobile-appUpdatePrompt.test.ts",
    "apps/mobile/**/*.ts",
    "apps/mobile/**/*.tsx",
    "packages/mobile-navigation/**/*.ts"
  ],
  "exclude": ["node_modules", "../node_modules", "**/dist", "**/node_modules"]
}
