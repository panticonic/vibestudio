{
  "//": "The shipped client runs in Hermes, not the Node/Jest test harness. Check it without browser or Node globals and with the real native package entries.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["react", "react-native"],
    "customConditions": ["react-native"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true
  },
  "include": [
    "clients/mobile-browser/**/*.ts",
    "clients/mobile-browser/**/*.tsx",
    "packages/client-kit-native/**/*.ts",
    "packages/client-kit-native/**/*.tsx",
    "packages/mobile-navigation/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../node_modules",
    "**/dist",
    "**/node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "clients/mobile-browser/jest.setup.ts"
  ]
}
