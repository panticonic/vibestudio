{
  "name": "@vibestudio/client-host-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "buildProfile": "source-only"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./hostDescriptor": "./src/hostDescriptor.ts",
    "./launch": "./src/launch.ts",
    "./artifactCache": "./src/artifactCache.ts",
    "./updates": "./src/updates.ts",
    "./intents": "./src/intents.ts",
    "./notifications": "./src/notifications.ts",
    "./node": "./src/nodeArtifactStore.ts"
  },
  "scripts": {
    "test": "cd ../.. && vitest run --config vitest.host.config.ts hosts/core",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@vibestudio/service-schemas": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@vibestudio/workspace-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "7.0.2"
  }
}
