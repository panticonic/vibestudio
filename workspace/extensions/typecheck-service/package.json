{
  "name": "@workspace-extensions/typecheck-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "displayName": "Typecheck Service",
    "entry": "index.ts",
    "sourcemap": true,
    "extension": {
      "activationEvents": [
        "onInvoke"
      ],
      "methodAuthority": {
        "checkPanel": {
          "effect": {
            "kind": "open"
          }
        },
        "check": {
          "effect": {
            "kind": "open"
          }
        },
        "getTypeInfo": {
          "effect": {
            "kind": "open"
          }
        },
        "getCompletions": {
          "effect": {
            "kind": "open"
          }
        },
        "getBrowserTypeDefinitions": {
          "effect": {
            "kind": "open"
          }
        }
      }
    },
    "authority": {
      "provides": [],
      "requests": [
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "critical",
          "evidence": "intentional-broad"
        }
      ]
    }
  },
  "dependencies": {
    "@vibestudio/env-paths": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@vibestudio/typecheck": "workspace:*"
  }
}
