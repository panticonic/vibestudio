{
  "name": "@workspace-extensions/test-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "displayName": "Workspace Test Runner",
    "entry": "index.ts",
    "sourcemap": true,
    "extension": {
      "dependencyMode": "external",
      "activationEvents": [
        "onInvoke"
      ],
      "methodAuthority": {
        "run": {
          "effect": {
            "kind": "userland-capability",
            "capability": "native.tests.execute",
            "resource": {
              "kind": "receiver"
            }
          }
        }
      }
    },
    "authority": {
      "provides": [
        {
          "name": "native.tests.execute",
          "title": "Run workspace tests",
          "action": "execute workspace test code",
          "tier": "gated",
          "sensitivity": "write",
          "resourceType": "native.tests",
          "presentation": {
            "domain": "automation",
            "verb": "act"
          },
          "notability": "headline",
          "grantScopes": [
            "once",
            "task",
            "session"
          ]
        }
      ],
      "requests": [
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "critical",
          "evidence": "intentional-broad"
        }
      ]
    }
  },
  "dependencies": {
    "vitest": "^3.2.2"
  }
}
