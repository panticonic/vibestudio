          "tier": "gated",
          "sensitivity": "write",
          "resourceType": "workspace.templates",
          "presentation": {
            "domain": "files",
            "verb": "manage"
          },
          "notability": "headline",
          "grantScopes": [
            "once"
          ]
        },
        {
          "name": "workspace.templates.update",
          "title": "Update this template?",
