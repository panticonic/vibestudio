        "catalog": {
          "effect": {
            "kind": "open"
          }
        },
        "operations": {
          "effect": {
            "kind": "open"
          }
        },
        "cancel": {
          "effect": {
            "kind": "userland-capability",
            "capability": "workspace.templates.change",
            "resource": {
              "kind": "receiver"
            }
          }
        },
        "resume": {
          "effect": {
            "kind": "userland-capability",
            "capability": "workspace.templates.change",
            "resource": {
              "kind": "receiver"
            }
          }
        },
        "check": {
          "effect": {
            "kind": "open"
          }
        },
        "inspect": {
          "effect": {
            "kind": "open"
          }
        },
        "prepareAdd": {
          "effect": {
            "kind": "open"
          }
        },
        "inspectAuthoring": {
          "effect": {
            "kind": "open"
          }
        },
        "authoringParts": {
          "effect": {
            "kind": "open"
          }
        },
        "publishAuthoring": {
          "effect": {
            "kind": "userland-capability",
            "capability": "workspace.templates.change",
            "resource": {
              "kind": "receiver"
            }
          }
        },
        "add": {
          "effect": {
            "kind": "userland-capability",
            "capability": "workspace.templates.add",
            "resource": {
              "kind": "receiver"
            }
          }
