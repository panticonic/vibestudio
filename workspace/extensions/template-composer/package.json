          "sensitivity": "write",
          "resourceType": "workspace.templates",
          "presentation": {
            "domain": "sharing",
            "verb": "act"
          },
          "notability": "everyday",
          "grantScopes": [
            "once"
          ]
        },
        {
          "name": "workspace.templates.change",
          "title": "Change workspace templates",
          "action": "change the workspace template composition",
          "tier": "gated",
          "sensitivity": "write",
          "resourceType": "workspace.templates",
          "presentation": {
            "domain": "files",
            "verb": "manage"
          },
          "notability": "headline",
          "grantScopes": [
            "once",
            "task",
            "session"
          ]
        }
